# Copy to /etc/default/larkbot-firewall (root-owned, 0644) and edit to match
# docker-compose.yml. The firewall service, its 5-minute check timer and manual
# `larkbot-firewall` runs all read this file; an environment variable already
# set on the command line wins over it.
#
#   sudo install -m 0644 deploy/larkbot-firewall.env.example /etc/default/larkbot-firewall
#   sudo systemctl restart larkbot-firewall larkbot-firewall-check.timer
#
# Shell-style file: KEY=value lines, optional quotes, no `export` needed.

# The sandbox bridge subnet from docker-compose.yml (`networks.sandbox-net`).
SUBNET=172.31.250.0/24

# Must match the sandbox `dns:` list in docker-compose.yml: port 53 is allowed
# only to these addresses. They must be reachable without a transparent proxy.
# On hosts in mainland China 1.1.1.1/8.8.8.8 are often unreliable; use a local
# public resolver there (e.g. 223.5.5.5) in both places.
DNS_RESOLVERS="1.1.1.1 8.8.8.8"

# Set to 1 on hosts running a fake-IP TUN proxy (mihomo/clash/sing-box) so the
# sandbox subnet bypasses the proxy and the firewall sees real addresses.
# Read the "Transparent proxy on the host" section of docs/deploy.md first.
#BYPASS_TUN=1

# ip-rule preference for the bypass rule. Must be LOWER than the proxy's own
# rules (check with `ip rule show`; mihomo/clash setups commonly use 9000+).
#BYPASS_TUN_PREF=8999

# Only for a host that has NO transparent proxy at all: setting NO_TUN=1 lets
# ALLOW_PROXY be used without BYPASS_TUN. Do not set it on a proxy host.
#NO_TUN=1

# Optional: allow the sandbox to reach exactly one filtering HTTP/SOCKS proxy,
# e.g. one listening on the sandbox bridge gateway. Requires BYPASS_TUN=1 or
# NO_TUN=1, and is meant to be used together with SANDBOX_HTTP_PROXY on the bot
# container (docs/deploy.md 3.8, Option B). The proxy must itself refuse
# private/loopback destinations; the environment variable alone confines
# nothing.
#ALLOW_PROXY=172.31.250.1:3128
