# Copy to deploy/.env (gitignored) so that `docker compose` run from this
# directory also loads docker-compose.override.yml:
#
#   cd deploy
#   cp docker-compose.override.example.yml docker-compose.override.yml
#   cp .env.example .env
#
# NOTE: an explicit `-f` flag on the command line disables COMPOSE_FILE, so run
# compose from deploy/ (or pass both files after -f). docs/deploy.md has the
# details.
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml
